# ─── Database (Required) ─────────────────────────────────
# Free PostgreSQL: https://neon.tech → New Project → Copy connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── AI / Gemini (Required) ──────────────────────────────
# Free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."

# ─── Admin Panel (Required) ──────────────────────────────
# Choose any strong password — protects /admin pages
ADMIN_PASSWORD="change-this-to-a-strong-password"

# ─── App URL (Required) ──────────────────────────────────
# Your actual domain after deployment
NEXT_PUBLIC_APP_URL="https://iltes-sathi.com"

# ─── Audio CDN (Optional but recommended) ────────────────
# If blank: audio streams live from external sites (slower)
# Setup: Upload public/audio/ to Cloudflare R2, set URL here
# Example: https://pub-xxxxx.r2.dev/audio
NEXT_PUBLIC_AUDIO_CDN_URL=""

# ─── WhatsApp Order Alerts (Optional) ────────────────────
# Get free instance: https://green-api.com
# Leave blank to disable WhatsApp notifications
GREEN_API_INSTANCE=""
GREEN_API_TOKEN=""
ADMIN_WHATSAPP=""
